generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}


datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id                 String                   @id @default(cuid())
  name               String
  email              String                   @unique
  password           String?
  profileImage       String?                  @map("profile_image")
  provider           AuthProvider[]           @default([])
  isVerified         Boolean                  @default(false) @map("is_verified")
  createdAt          DateTime                 @default(now()) @map("created_at")
  childProfile       ChildProfile?
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  subscriptions      UserSubscription[]
  payments             Payment[]
  chatSessions         ChatSession[]
  chatSessionMessages  ChatSessionMessage[]
  createdAds           Ad[]               @relation("AdCreatedBy")
  updatedAds           Ad[]               @relation("AdUpdatedBy")

  @@map("users")
}

model ChildProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique @map("user_id")
  name               String
  ageGroup           String              @map("age_group")
  favoriteColor      String              @map("favorite_color")
  favoriteCharacter  String              @map("favorite_character")
  createdAt          DateTime            @default(now()) @map("created_at")
  childBadges        ChildBadge[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameProgress       GameProgress[]
  lessonProgress     LessonProgress[]
  progressRecords    ProgressRecord[]
  quizAttempts       QuizAttempt[]
  rewardTransactions RewardTransaction[]
  rewardWallet       RewardWallet?
  storyProgress      StoryProgress[]

  @@map("child_profiles")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @map("token_hash")
  codeHash   String    @map("code_hash")
  verifiedAt DateTime? @map("verified_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  userId     String?   @map("user_id")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @map("token_hash")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id            String                @id @default(cuid())
  name          String
  description   String?
  price         Int
  durationDays  Int
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  features      SubscriptionFeature[]
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  planId    String                @map("plan_id")
  status    SubscriptionStatus    @default(ACTIVE)
  startDate DateTime              @map("start_date")
  endDate   DateTime              @map("end_date")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  features  SubscriptionFeature[]
  plan      SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@map("user_subscriptions")
}

model SubscriptionFeature {
  id             String            @id @default(cuid())
  planId         String            @map("plan_id")
  subscriptionId String?           @map("subscription_id")
  featureKey     String            @map("feature_key")
  featureValue   String            @map("feature_value")
  createdAt      DateTime          @default(now()) @map("created_at")
  plan           SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_features")
}

model Language {
  id        String          @id @default(cuid())
  code      String          @unique
  name      String
  native    String?
  flag      String?
  isActive  Boolean         @default(true) @map("is_active")
  sortOrder Int             @default(0) @map("sort_order")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  games     Game[]
  levels    LanguageLevel[]
  lessons   Lesson[]
  quizzes   Quiz[]
  stories   Story[]

  @@map("languages")
}

model Level {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  games       Game[]
  languages   LanguageLevel[]
  lessons     Lesson[]
  quizzes     Quiz[]

  @@map("levels")
}

model LanguageLevel {
  id         String   @id @default(cuid())
  languageId String   @map("language_id")
  levelId    String   @map("level_id")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([languageId, levelId])
  @@map("language_levels")
}

model Story {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  subtitle         String?
  description      String?
  content          String
  pages            Json?
  author           String?
  category         String?
  ageGroup         String?         @map("age_group")
  difficulty       String?
  tags             String[]        @default([])
  coverImage       String?         @map("cover_image")
  thumbnail        String?
  thumbnailUrl     String?         @map("thumbnail_url")
  backgroundUrl    String?         @map("background_url")
  coverEmoji       String?         @map("cover_emoji")
  coverGradient    String?         @map("cover_gradient")
  readingTime      Int?            @map("reading_time")
  listeningTime    Int?            @map("listening_time")
  duration         String?
  isPremium        Boolean         @default(false) @map("is_premium")
  isPublished      Boolean         @default(true) @map("is_published")
  isFeatured       Boolean         @default(false) @map("is_featured")
  isTrending       Boolean         @default(false) @map("is_trending")
  isRecommended    Boolean         @default(false) @map("is_recommended")
  readAloudEnabled Boolean         @default(false) @map("read_aloud_enabled")
  narratorVoice    String?         @map("narrator_voice")
  audioUrl         String?         @map("audio_url")
  xpReward         Int             @default(0) @map("xp_reward")
  starsReward      Int             @default(0) @map("stars_reward")
  likesCount       Int             @default(0) @map("likes_count")
  readsCount       Int             @default(0) @map("reads_count")
  favoritesCount   Int             @default(0) @map("favorites_count")
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  languageId       String?         @map("language_id")
  quizzes          Quiz[]
  language         Language?       @relation(fields: [languageId], references: [id])
  progress         StoryProgress[]

  @@index([category])
  @@index([languageId])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([difficulty])
  @@index([isPublished, createdAt])
  @@index([isPublished, isFeatured])
  @@index([isPublished, category])
  @@index([isPremium])
  @@map("stories")
}

model StoryProgress {
  id                 String       @id @default(cuid())
  childProfileId     String       @map("child_profile_id")
  storyId            String       @map("story_id")
  progressPercentage Int          @default(0) @map("progress_percentage")
  lastReadPosition   Int?         @map("last_read_position")
  isCompleted        Boolean      @default(false) @map("is_completed")
  completedAt        DateTime?    @map("completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  childProfile       ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  story              Story        @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, storyId])
  @@map("story_progress")
}

model Lesson {
  id          String           @id @default(cuid())
  lessonCode  String?          @unique @map("lesson_code")
  slug        String           @unique
  title       String
  description String?
  intro       String?
  emoji       String?
  color       String?
  category    String?
  tags        String[]         @default([])
  status      String           @default("draft")
  isPremium   Boolean          @default(false) @map("is_premium")
  isPublished Boolean          @default(true) @map("is_published")
  sortOrder   Int              @default(0) @map("sort_order")
  archivedAt  DateTime?        @map("archived_at")
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  languageId  String           @map("language_id")
  levelId     String           @map("level_id")
  cards       LessonCard[]
  progress    LessonProgress[]
  language    Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)
  level       Level            @relation(fields: [levelId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]
  versions    LessonVersion[]

  @@index([languageId, levelId])
  @@index([status])
  @@index([lessonCode])
  @@index([isPublished, createdAt])
  @@index([isPublished, languageId])
  @@index([isPremium])
  @@map("lessons")
}

model LessonCard {
  id        String   @id @default(cuid())
  lessonId  String   @map("lesson_id")
  word      String
  translit  String?
  meaning   String?
  emoji     String?
  imageUrl  String?  @map("image_url")
  audioUrl  String?  @map("audio_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("lesson_cards")
}

model LessonProgress {
  id                 String       @id @default(cuid())
  childProfileId     String       @map("child_profile_id")
  lessonId           String       @map("lesson_id")
  progressPercentage Int          @default(0) @map("progress_percentage")
  isCompleted        Boolean      @default(false) @map("is_completed")
  completedAt        DateTime?    @map("completed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  childProfile       ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  lesson             Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, lessonId])
  @@map("lesson_progress")
}

model Quiz {
  id          String         @id @default(cuid())
  title       String
  description String?
  isPremium   Boolean        @default(false) @map("is_premium")
  isPublished Boolean        @default(true) @map("is_published")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  languageId  String?        @map("language_id")
  levelId     String?        @map("level_id")
  lessonId    String?        @map("lesson_id")
  storyId     String?        @map("story_id")
  attempts    QuizAttempt[]
  questions   QuizQuestion[]
  language    Language?      @relation(fields: [languageId], references: [id])
  lesson      Lesson?        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  level       Level?         @relation(fields: [levelId], references: [id])
  story       Story?         @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([storyId])
  @@map("quizzes")
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String   @map("quiz_id")
  type        String   @default("mcq")
  question    String
  emoji       String?
  options     Json?
  answer      String
  hint        String?
  explanation String?
  points      Int      @default(1)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String       @id @default(cuid())
  childProfileId String       @map("child_profile_id")
  quizId         String       @map("quiz_id")
  score          Int          @default(0)
  totalPoints    Int          @default(0) @map("total_points")
  starsEarned    Int          @default(0) @map("stars_earned")
  answers        Json?
  isCompleted    Boolean      @default(true) @map("is_completed")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  quiz           Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([childProfileId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Game {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String?
  category    String?
  icon        String?
  color       String?
  starsReward Int            @default(0) @map("stars_reward")
  isPremium   Boolean        @default(false) @map("is_premium")
  isActive    Boolean        @default(true) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  languageId  String?        @map("language_id")
  levelId     String?        @map("level_id")
  progress    GameProgress[]
  language    Language?      @relation(fields: [languageId], references: [id])
  level       Level?         @relation(fields: [levelId], references: [id])

  @@index([languageId])
  @@index([levelId])
  @@index([isActive])
  @@map("games")
}

model GameProgress {
  id             String       @id @default(cuid())
  childProfileId String       @map("child_profile_id")
  gameId         String       @map("game_id")
  score          Int          @default(0)
  highScore      Int          @default(0) @map("high_score")
  attempts       Int          @default(0)
  isCompleted    Boolean      @default(false) @map("is_completed")
  lastPlayedAt   DateTime?    @map("last_played_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  game           Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, gameId])
  @@map("game_progress")
}

model ProgressRecord {
  id                 String              @id @default(cuid())
  childProfileId     String              @map("child_profile_id")
  contentType        ProgressContentType @map("content_type")
  contentId          String              @map("content_id")
  progressPercentage Int                 @default(0) @map("progress_percentage")
  isCompleted        Boolean             @default(false) @map("is_completed")
  metadata           Json?
  completedAt        DateTime?           @map("completed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  childProfile       ChildProfile        @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, contentType, contentId])
  @@map("progress_records")
}

model RewardWallet {
  id             String       @id @default(cuid())
  childProfileId String       @unique @map("child_profile_id")
  stars          Int          @default(0)
  coins          Int          @default(0)
  xp             Int          @default(0)
  level          Int          @default(1)
  streak         Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@map("reward_wallets")
}

model Badge {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  imageUrl    String?      @map("image_url")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  children    ChildBadge[]

  @@map("badges")
}

model ChildBadge {
  id             String       @id @default(cuid())
  childProfileId String       @map("child_profile_id")
  badgeId        String       @map("badge_id")
  earnedAt       DateTime     @default(now()) @map("earned_at")
  badge          Badge        @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@unique([childProfileId, badgeId])
  @@map("child_badges")
}

model RewardTransaction {
  id             String       @id @default(cuid())
  childProfileId String       @map("child_profile_id")
  type           RewardType
  amount         Int          @default(0)
  reason         String?
  sourceType     String?      @map("source_type")
  sourceId       String?      @map("source_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)

  @@index([childProfileId])
  @@map("reward_transactions")
}

enum AuthProvider {
  email
  google
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ProgressContentType {
  LANGUAGE
  LESSON
  STORY
  GAME
}

enum RewardType {
  STARS
  COINS
  BADGE
}

model Payment {
  id                 String            @id @default(cuid())
  userId             String            @map("user_id")
  subscriptionId     String?           @map("subscription_id")
  amount             Int
  status             String
  razorpayOrderId    String            @map("razorpay_order_id") @unique
  razorpayPaymentId  String?           @map("razorpay_payment_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model LessonVersion {
  id         String   @id @default(cuid())
  lessonId   String   @map("lesson_id")
  version    Int
  snapshot   Json
  changeNote String?  @map("change_note")
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@unique([lessonId, version])
  @@map("lesson_versions")
}

model ImportAuditLog {
  id           String   @id @default(cuid())
  importType   String   @map("import_type")
  fileName     String?  @map("file_name")
  importedBy   String   @map("imported_by")
  totalRecords Int      @default(0) @map("total_records")
  successCount Int      @default(0) @map("success_count")
  failureCount Int      @default(0) @map("failure_count")
  errors       Json?
  status       String   @default("completed")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([importedBy])
  @@index([createdAt])
  @@map("import_audit_logs")
}

model Media {
  id           String   @id @default(cuid())
  fileName     String   @map("file_name")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  url          String
  provider     String   @default("local")
  folder       String?
  altText      String?  @map("alt_text")
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  adMedia      Ad[]     @relation("AdMedia")
  adMobileMedia Ad[]    @relation("AdMobileMedia")
  adTabletMedia Ad[]    @relation("AdTabletMedia")
  adDesktopMedia Ad[]   @relation("AdDesktopMedia")

  @@index([folder])
  @@index([mimeType])
  @@map("media")
}

// ── RAG: Content Embeddings ──────────────────────────────────────

model ContentEmbedding {
  id         String   @id @default(cuid())
  sourceType String   @map("source_type") // "story" | "lesson" | "game"
  sourceId   String   @map("source_id")
  title      String
  chunkText  String   @map("chunk_text")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([sourceType, sourceId])
  @@map("content_embeddings")
}

// ── RAG: Chat History ────────────────────────────────────────────

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String?       @map("user_id")
  sessionId String        @map("session_id")
  createdAt DateTime      @default(now()) @map("created_at")
  messages  ChatMessage[]

  @@index([sessionId])
  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  role           String           // "user" | "assistant"
  content        String
  sources        Json?            // [{title, sourceType, sourceId}]
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("chat_messages")
}

// ── Persistent Chat History (UX layer) ──────────────────────────────

model ChatSession {
  id            String               @id @default(cuid())
  userId        String               @map("user_id")
  title         String               @default("New Chat")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  lastMessageAt DateTime             @default(now()) @map("last_message_at")
  isDeleted     Boolean              @default(false) @map("is_deleted")
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      ChatSessionMessage[]

  @@index([userId, isDeleted])
  @@index([lastMessageAt])
  @@map("chat_sessions")
}

model ChatSessionMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  userId    String      @map("user_id")
  role      MessageRole
  content   String
  createdAt DateTime    @default(now()) @map("created_at")
  metadata  Json?       // future: images, voice, PDF refs, AI memory, streaming info, route taken
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
  @@map("chat_session_messages")
}

enum MessageRole {
  user
  assistant
  system
}

model AiModel {
  id          String   @id @default(uuid())
  displayName String   @map("display_name")
  modelName   String   @map("model_name")
  apiKey      String?  @map("api_key")
  isActive    Boolean  @default(false) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ai_models")
}

model AiPromptSetting {
  id                 String   @id @default(uuid())
  ageGroup           String   @default("3-12") @map("age_group")
  maxResponseWords   Int      @default(50) @map("max_response_words")
  language           String   @default("en")
  difficulty         String   @default("beginner")
  allowedTopics      String[] @default(["Animals", "Science", "Mathematics", "English Grammar", "Stories", "General Knowledge", "Nature", "Space & Planets", "Fun Facts & Riddles", "Creative Arts", "Life Skills"]) @map("allowed_topics")
  safetyRules        String[] @default(["No politics, elections, or government debates", "No violence, weapons, gore, or self-harm", "No adult content, profanity, or inappropriate language", "No drugs, alcohol, vaping, or gambling", "No medical diagnoses or personal data sharing"]) @map("safety_rules")
  customInstructions String?  @map("custom_instructions")
  responseTone       String   @default("encouraging") @map("response_tone")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("ai_prompt_settings")
}

// ── Life Skills Practice ─────────────────────────────────────────

model LifeSkillScenario {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  description      String
  icon             String   // emoji icon e.g. "🍽️"
  characterName    String   @map("character_name")  // e.g. "Chef Marco"
  characterAvatar  String?  @map("character_avatar") // emoji for avatar
  coverGradient    String   @default("linear-gradient(135deg, #1A6B5A 0%, #2E9E80 55%, #72D6B0 100%)") @map("cover_gradient")
  systemPrompt     String   @map("system_prompt")
  modelName        String?  @map("model_name")  // dedicated OpenRouter model slug, null = use global active model
  apiKey           String?  @map("api_key")     // optional per-scenario override key
  maxWords         Int      @default(60) @map("max_words")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("life_skill_scenarios")
}

// ── StoryWeaver Audio Stories ─────────────────────────────────────

model StoryWeaverAudio {
  id             String    @id @default(cuid())
  swId           String    @unique @map("sw_id")
  slug           String    @unique
  title          String
  language       String    @default("English")
  level          String?
  description    String?
  synopsis       String?
  coverImage     String?   @map("cover_image")
  authors        String[]  @default([])
  illustrators   String[]  @default([])
  publisher      String?
  readsCount     Int       @default(0) @map("reads_count")
  likesCount     Int       @default(0) @map("likes_count")
  isAudio        Boolean   @default(true) @map("is_audio")
  hasAudio       Boolean   @default(false) @map("has_audio")
  pageTimestamps Json?     @map("page_timestamps")
  pages          Json?
  totalPages     Int       @default(0) @map("total_pages")
  orientation    String?   @default("landscape")
  isSynced       Boolean   @default(true) @map("is_synced")
  syncedAt       DateTime  @default(now()) @map("synced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([language])
  @@index([level])
  @@index([isAudio])
  @@index([hasAudio])
  @@index([language, level])
  @@map("storyweaver_audios")
}



// -- Advertisement Management -----------------------------------------------

model Ad {
  id                     String    @id @default(cuid())
  name                   String
  title                  String
  description            String?
  format                 String
  status                 String    @default("DRAFT")
  slot                   String
  deviceTarget           String    @default("ALL") @map("device_target")
  mediaId                String?   @map("media_id")
  mobileMediaId          String?   @map("mobile_media_id")
  tabletMediaId          String?   @map("tablet_media_id")
  desktopMediaId         String?   @map("desktop_media_id")
  clickUrl               String?   @map("click_url")
  internalRoute          String?   @map("internal_route")
  ctaText                String?   @map("cta_text")
  priority               Int       @default(5)
  startAt                DateTime? @map("start_at")
  endAt                  DateTime? @map("end_at")
  frequencyLimit         Int?      @map("frequency_limit")
  maxDisplaysPerDay      Int?      @map("max_displays_per_day")
  minTimeBetweenDisplays Int?      @map("min_time_between_displays")
  popupTrigger           String?   @map("popup_trigger")
  popupDelay             Int?      @map("popup_delay")
  isActive               Boolean   @default(true) @map("is_active")
  impressionCount        Int       @default(0) @map("impression_count")
  clickCount             Int       @default(0) @map("click_count")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  createdById            String?   @map("created_by_id")
  updatedById            String?   @map("updated_by_id")
  media                  Media?    @relation("AdMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  mobileMedia            Media?    @relation("AdMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)
  tabletMedia            Media?    @relation("AdTabletMedia", fields: [tabletMediaId], references: [id], onDelete: SetNull)
  desktopMedia           Media?    @relation("AdDesktopMedia", fields: [desktopMediaId], references: [id], onDelete: SetNull)
  createdBy              User?     @relation("AdCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?     @relation("AdUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  events                 AdEvent[]

  @@index([slot])
  @@index([status])
  @@index([isActive])
  @@index([slot, status, isActive])
  @@index([deviceTarget])
  @@index([priority])
  @@map("ads")
}

model AdEvent {
  id        String   @id @default(cuid())
  adId      String   @map("ad_id")
  type      String
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)

  @@index([adId, type])
  @@index([createdAt])
  @@map("ad_events")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
